{
  "name": "test-prep-platform",
  "version": "0.1.0",
  "description": "Test-prep learning platform frontend and content CMS",
  "license": "MIT",
  "packageManager": "npm@11.12.1",
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "payload",
    "payload:importmap": "payload generate:importmap",
    "payload:types": "payload generate:types",
    "cms:create-admin": "tsx scripts/create-admin.ts",
    "cms:seed-demo": "tsx scripts/seed-demo-content.ts",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate": "payload migrate",
    "payload:migrate:status": "payload migrate:status",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:int": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "@payloadcms/db-postgres": "3.90.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10"
  }
}
